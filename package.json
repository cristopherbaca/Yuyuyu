{
  "name": "dynamic-flashcards",
  "version": "0.1.0",
  "description": "Dynamic Flashcards desktop frontend demo with light and dark themes",
  "author": "Dynamic Flashcards",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && node scripts/dist.ts",
    "test:electron": "node scripts/smoke.ts",
    "format": "prettier --write src tests scripts electron.vite.config.ts vitest.config.ts package.json tsconfig.json electron-builder.yml README.md",
    "format:check": "prettier --check src tests scripts electron.vite.config.ts vitest.config.ts package.json tsconfig.json electron-builder.yml README.md",
    "postinstall": "install-electron --no"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-math": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "desktopName": "dynamic-flashcards.desktop"
}
